# ── Required ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. With row level security on (schema.sql), every write needs it
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Grok AI (optional — falls back to rule engine) ────────
XAI_API_KEY=xai-...
GROK_MODEL=grok-3
# Other providers, tried in order after xAI
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# Daily LLM spend cap; past it, agents use the rule engine until midnight UTC
LLM_DAILY_TOKEN_BUDGET=300000
LLM_DAILY_CALL_BUDGET=2000

# ── Auth (magic link) ─────────────────────────────────────
# Enable in Supabase Dashboard → Authentication → Email
# Redirect URL: http://localhost:3000/auth/callback

# ── Owner emails (optional) ───────────────────────────────
# "Deal found, approve?" emails via Resend. Without these, approvals still
# show in the header bell.
# RESEND_API_KEY=re_...
# NOTIFY_FROM=BotMart <agents@your-domain.com>
# Used for links in emails (defaults to the Vercel production URL)
# NEXT_PUBLIC_SITE_URL=https://bot-mart.vercel.app

# ── Rate limiting ─────────────────────────────────────────
# Salt for hashing client IPs (any random string)
RATE_LIMIT_SALT=change-me

# ── Cron (Vercel) ─────────────────────────────────────────
# Set the same value in Vercel project env; cron routes check Bearer token
CRON_SECRET=generate-a-long-random-string

# ── Stripe test mode (optional) ───────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Demo mode ─────────────────────────────────────────────
# When true, public pages stay open without forcing login
NEXT_PUBLIC_DEMO_MODE=true
