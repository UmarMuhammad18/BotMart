# ── Required ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Grok AI (optional — falls back to rule engine) ────────
XAI_API_KEY=xai-...
GROK_MODEL=grok-3

# ── Auth (magic link) ─────────────────────────────────────
# Enable in Supabase Dashboard → Authentication → Email
# Redirect URL: http://localhost:3000/auth/callback

# ── Cron (Vercel) ─────────────────────────────────────────
# Set the same value in Vercel project env; cron routes check Bearer token
CRON_SECRET=generate-a-long-random-string

# ── Stripe test mode (optional) ───────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Demo mode ─────────────────────────────────────────────
# When true, public pages stay open without forcing login
NEXT_PUBLIC_DEMO_MODE=true
